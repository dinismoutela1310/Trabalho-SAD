					<Id>1793029047370</Id>
					<Name><![CDATA[filaEntrada]]></Name>
					<X>40</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return queueAntesPedidos.size()
     + moveToPedido1.size() + moveToPedido2.size()
     + seizePedido1.size() + delayPedido1.size() 
     + seizePedido2.size() + delayPedido2.size()
     + moveToPagamento.size() + seizePagamento.size()
     + delayPagamento.size() + moveToRecolha.size() 
     + seizeRecolha.size() + delayRecolha.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793029389379</Id>
					<Name><![CDATA[desistênciaFilaEntrada]]></Name>
					<X>40</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[n]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (n >= 15) return 1.0;
double z = -4.39 + 0.44 * n;
return 1.0 / (1.0 + Math.exp(-z));
// -4,39 e 0,44 representam a sensibilidade à fila e foram escolhidos para que fila de 5 carros cause 10% de desistências e 10 carros 50%]]></Body>
				</Function>

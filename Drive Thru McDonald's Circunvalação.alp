							<Value Class="CodeValue">
								<Code><![CDATA[if (delayRecolha.size() > 0){
	
	Carro carroJanela = (Carro) delayRecolha.get(0);
	
	double tempoJaPassado = time() - carroJanela.horaInicioRecolha;
	double tempoRestanteCarro1 = carroJanela.DelayRecolha - tempoJaPassado;
	
	
	if (tempoRestanteCarro1 > agent.DelayRecolha && (moveToWB.size() + delayWB.size() + chamarFuncionario.size() + entregaComida.size())< CapacidadeWaitingBay){
		
		carroJanela.DelayRecolha = tempoRestanteCarro1;
		
		delayRecolha.stopDelay(carroJanela);
	}
}]]></Code>
